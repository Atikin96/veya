# Template of infra/.env (git-ignored). Do not put real values here.
# Create infra/.env with random passwords:   sh infra/generate-env.sh
# Docker Compose and the API (started from backend/) both read infra/.env.
VEYA_DB_NAME=veya
VEYA_DB_PORT=5433

# Bootstrap superuser (init script / maintenance only; the API never uses it).
VEYA_POSTGRES_PASSWORD=

# Login roles created by infra/postgres/initdb/01-create-roles.sh.
VEYA_OWNER_PASSWORD=
VEYA_APP_PASSWORD=
VEYA_READONLY_PASSWORD=
VEYA_ADMIN_PASSWORD=

# API access-token signing key: Base64 of at least 32 random bytes (generate-env.sh creates one).
VEYA_JWT_SECRET=
